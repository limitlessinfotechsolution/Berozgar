# Copy to .env.local.

# The site's public origin. Goes into the sitemap, robots.txt, canonical URLs and
# OG image URLs, so a production build FAILS if it isn't set. Dev falls back to :3003.
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Berozgar ERP public API (apps/api in ../Berozgar). Read at request time, so a
# deployed build needs it in the host's RUNTIME environment, not just the build.
ERP_API_URL=http://localhost:3001

# Deploy-time alternative, for hosts whose runtime environment is hard to reach:
# NEXT_PUBLIC_* is inlined into the bundle at build, server code included. Set
# this OR ERP_API_URL — the private one wins. Never put a secret behind a
# NEXT_PUBLIC_ name; it ships in client JS. Unused locally.
# NEXT_PUBLIC_ERP_API_URL=

# Shared secret for /api/revalidate — must equal STOREFRONT_REVALIDATE_SECRET in the ERP admin's .env
REVALIDATE_SECRET=

# Customer accounts (docs/INTEGRATION.md §6). Must equal STOREFRONT_SERVER_SECRET in the ERP
# apps/api .env: with it the ERP trusts the shopper IP this server forwards (x-bz-client-ip) for
# its per-shopper rate limits. Without it every shopper shares this server's IP. Generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ERP_SERVER_SECRET=

# Reverse proxies / load balancers in front of this app that append to x-forwarded-for (0 locally).
TRUSTED_PROXY_COUNT=0
